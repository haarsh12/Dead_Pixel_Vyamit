# ============================================
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# --------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------
# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres:your_password@db.xxx.supabase.co:5432/postgres

# Enable SQL query logging (1=enabled, 0=disabled)
DB_ECHO=0

# --------------------------------------------
# SECURITY
# --------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# --------------------------------------------
# EMBEDDING CONFIGURATION
# --------------------------------------------
# Embedding provider selection:
# 1 = Gemini API (768D embeddings)
EMBEDDING_PROVIDER=1

# Google Gemini API Key (required for embeddings)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------
# LLM CONFIGURATION
# --------------------------------------------
# Mistral API Key (primary LLM)
MISTRAL_API_KEY=your_mistral_api_key_here

# --------------------------------------------
# SMS/OTP CONFIGURATION
# --------------------------------------------
# Fast2SMS API Key for OTP and bill sharing
# Get from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OTP Demo Mode (for testing, always returns 112233)
# Set to 1 for local testing, 0 for production
OTP_DEMO_MODE=0

# Log OTP codes to console (DANGEROUS - only for debugging)
LOG_OTP_CODES=0

# --------------------------------------------
# CORS CONFIGURATION
# --------------------------------------------
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000,https://your-frontend-domain.com

# --------------------------------------------
# DEPLOYMENT
# --------------------------------------------
# Set by hosting provider (Render, Railway, etc.)
# Leave empty for local development
RENDER=
PORT=8000
